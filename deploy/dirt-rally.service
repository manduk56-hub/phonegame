[Unit]
Description=DIRT RALLY game server
After=network.target

[Service]
Type=simple
User=dirt-rally
Group=dirt-rally
WorkingDirectory=/opt/dirt-rally
EnvironmentFile=/etc/dirt-rally/server.env
ExecStart=/usr/bin/node /opt/dirt-rally/server.mjs
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
